{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "REDACTED",
    "ANTHROPIC_BASE_URL": "https://api.ai.tech.gov.sg/platform/models",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "bedrock.claude-sonnet-4-8[1m]",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Sonnet 4.8 · Alternate if encountering errors on Sonnet 5",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Sonnet (alternate)",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "bedrock.claude-haiku-4-5[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION": "Haiku 4.5 · Fastest for quick answers",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "Haiku",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "bedrock.claude-opus-4-8[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION": "Opus 4.8 · Most capable for complex work · ~2× usage vs Sonnet",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "Opus",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "bedrock.claude-sonnet-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION": "Sonnet 5 · Best for everyday tasks",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "Sonnet",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://cc-tel.gto.tech.gov.sg",
    "OTEL_EXPORTER_OTLP_HEADERS": "Authorization=Bearer 22e50dcd21090acc5849791eb6495ce6a98c8182bfbc03637bc90760566294d8",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_LOG_TOOL_CONTENT": "0",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_USER_PROMPTS": "0",
    "OTEL_METRICS_EXPORTER": "otlp"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "ask": [
      "Edit(~/.claude/settings.json)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(**/credentials*)",
      "Read(**/secrets*)",
      "Read(**/.aws/**)",
      "Edit(**/.aws/**)",
      "Read(**/.gcp/**)",
      "Edit(**/.gcp/**)",
      "Read(**/.azure/**)",
      "Edit(**/.azure/**)",
      "Read(**/.ssh/*)",
      "Edit(**/.ssh/*)",
      "Read(**/id_rsa*)"
    ],
    "defaultMode": "auto"
  },
  "model": "Opus",
  "modelOverrides": {
    "claude-haiku-4-5-20251001": "bedrock.claude-haiku-4-5[1m]",
    "claude-opus-4-8": "bedrock.claude-opus-4-8[1m]",
    "claude-sonnet-5/model": "bedrock.claude-sonnet-5[1m]"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/selwynyeow/.claude/harness/bin/harness check"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -z \"${HOME-}\" ]; then case \"${OSTYPE-}\" in msys*|cygwin*|win32*) printf '{}\\n'; if [ -z \"${ORCA_AGENT_HOOK_PORT-}\" ] || [ -z \"${ORCA_AGENT_HOOK_TOKEN-}\" ] || [ -z \"${ORCA_PANE_KEY-}\" ]; then exit 0; fi; { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || : ;; *) { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; printf '{}\\n' ;; esac; else case \"${OSTYPE-}\" in msys*|cygwin*|win32*) if [ -f \"${HOME-}/.orca/agent-hooks/claude-hook.cmd\" ]; then case \"${HOME-}\" in *\\&*|*\\^*|*\\(*|*\\)*|*\\;*|*,*|*=*|*%*|*\\!*) if [ -f \"${SYSTEMROOT-}/System32/WindowsPowerShell/v1.0/powershell.exe\" ]; then \"${SYSTEMROOT-}/System32/WindowsPowerShell/v1.0/powershell.exe\" -NoProfile -EncodedCommand ; else printf '{}\\n'; if [ -z \"${ORCA_AGENT_HOOK_PORT-}\" ] || [ -z \"${ORCA_AGENT_HOOK_TOKEN-}\" ] || [ -z \"${ORCA_PANE_KEY-}\" ]; then exit 0; fi; { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi ;; *) \"${HOME-}/.orca/agent-hooks/claude-hook.cmd\" ;; esac; else printf '{}\\n'; if [ -z \"${ORCA_AGENT_HOOK_PORT-}\" ] || [ -z \"${ORCA_AGENT_HOOK_TOKEN-}\" ] || [ -z \"${ORCA_PANE_KEY-}\" ]; then exit 0; fi; { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi ;; *) if [ -f \"${HOME-}/.orca/agent-hooks/claude-hook.sh\" ] && [ -r \"${HOME-}/.orca/agent-hooks/claude-hook.sh\" ] && [ -x \"${HOME-}/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"${HOME-}/.orca/agent-hooks/claude-hook.sh\"; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; printf '{}\\n'; fi ;; esac; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(python3 \"$HOME/.claude/scripts/usage.py\" --auto >/dev/null 2>&1 &) || :",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "chrome-devtools-axi",
            "timeout": 10
          }
        ]
